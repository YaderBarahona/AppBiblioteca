@model AppBiblioteca.Models.Prestamo

@{
    ViewData["Title"] = "Detalles del Préstamo";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Encabezado -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold">
                    <i class="bi bi-file-text text-primary"></i>
                    Detalles del Préstamo #@Model.TN_Id_Prestamo
                </h2>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>

            <!-- Card de Información del Préstamo -->
            <div class="card shadow-sm mb-4">
                <div class="card-header @(Model.TN_Id_Estado == 1 ? "bg-warning" : Model.TN_Id_Estado == 2 ? "bg-success" : Model.TN_Id_Estado == 3 ? "bg-primary" : "bg-danger") text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-bookmark-check"></i>
                            Estado: @Model.EstadoNombre
                        </h4>
                        @if (Model.TN_DiasAtraso > 0 && Model.TN_Id_Estado == 2)
                        {
                            <span class="badge bg-danger" style="font-size: 1rem;">
                                <i class="bi bi-exclamation-triangle"></i>
                                @Model.TN_DiasAtraso día(s) de atraso
                            </span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Información del Usuario -->
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">
                                <i class="bi bi-person-circle"></i>
                                Información del Usuario
                            </h5>

                            <div class="mb-3">
                                <label class="text-muted small">Nombre</label>
                                <p class="fw-bold">@Model.NombreUsuario</p>
                            </div>

                            <div class="mb-3">
                                <label class="text-muted small">Correo Electrónico</label>
                                <p class="fw-bold">
                                    <i class="bi bi-envelope"></i>
                                    <a href="mailto:@Model.EmailUsuario">@Model.EmailUsuario</a>
                                </p>
                            </div>
                        </div>

                        <!-- Información de Fechas -->
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">
                                <i class="bi bi-calendar-event"></i>
                                Fechas del Préstamo
                            </h5>

                            @if (Model.TF_FechaPrestamo.HasValue)
                            {
                                <div class="mb-3">
                                    <label class="text-muted small">Fecha de Préstamo</label>
                                    <p class="fw-bold">
                                        <i class="bi bi-calendar-check"></i>
                                        @Model.TF_FechaPrestamo.Value.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                </div>
                            }

                            @if (Model.TF_FechaDevolucion.HasValue)
                            {
                                <div class="mb-3">
                                    <label class="text-muted small">Fecha de Devolución Programada</label>
                                    <p class="fw-bold">
                                        <i class="bi bi-calendar-x"></i>
                                        @Model.TF_FechaDevolucion.Value.ToString("dd/MM/yyyy")
                                        @if (Model.TN_Id_Estado == 2 && Model.TF_FechaDevolucion.Value < DateTime.Now)
                                        {
                                            <span class="badge bg-danger ms-2">Vencido</span>
                                        }
                                    </p>
                                </div>
                            }

                            @if (Model.TF_FechaDevuelto.HasValue)
                            {
                                <div class="mb-3">
                                    <label class="text-muted small">Fecha Real de Devolución</label>
                                    <p class="fw-bold">
                                        <i class="bi bi-calendar-check-fill text-success"></i>
                                        @Model.TF_FechaDevuelto.Value.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card de Materiales -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-stack"></i>
                        Materiales Incluidos (@Model.Detalles.Count)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Detalles.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Título</th>
                                        <th>ISBN</th>
                                        <th>Autor(es)</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in Model.Detalles)
                                    {
                                        <tr>
                                            <td>@detalle.TN_Id_Detalle</td>
                                            <td>
                                                <strong>@detalle.TituloMaterial</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@detalle.ISBN</span>
                                            </td>
                                            <td>@detalle.Autores</td>
                                            <td>
                                                <a asp-controller="Materiales" asp-action="Details" asp-route-id="@detalle.TN_Id_Material"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> Ver Material
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            No hay materiales asociados a este préstamo.
                        </div>
                    }
                </div>
            </div>

            <!-- Alertas y Mensajes -->
            @if (Model.TN_DiasAtraso > 0 && Model.TN_Id_Estado == 2)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Préstamo Atrasado:</strong> Este préstamo tiene <strong>@Model.TN_DiasAtraso</strong> día(s) de atraso.
                    Se recomienda contactar al usuario para gestionar la devolución.
                </div>
            }

            @if (Model.TN_Id_Estado == 1)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-clock"></i>
                    <strong>Reserva Pendiente:</strong> Esta reserva está pendiente de aprobación.
                </div>
            }

            @if (Model.TN_Id_Estado == 3)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle"></i>
                    <strong>Devolución Completada:</strong> Este préstamo ha sido devuelto exitosamente.
                </div>
            }

            <!-- Botones de Acción -->
            @if (User.IsInRole("Bibliotecario") || User.IsInRole("Administrador"))
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Acciones</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.TN_Id_Estado == 1)
                        {
                            <!-- Reservado - Puede Aprobar o Cancelar -->
                            <form asp-action="Aprobar" asp-route-id="@Model.TN_Id_Prestamo" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success" onclick="return confirm('¿Está seguro de aprobar este préstamo?')">
                                    <i class="bi bi-check-circle"></i> Aprobar Préstamo
                                </button>
                            </form>
                            <form asp-action="Cancelar" asp-route-id="@Model.TN_Id_Prestamo" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger" onclick="return confirm('¿Está seguro de cancelar esta reserva?')">
                                    <i class="bi bi-x-circle"></i> Cancelar Reserva
                                </button>
                            </form>
                        }
                        else if (Model.TN_Id_Estado == 2)
                        {
                            <!-- Prestado - Puede Devolver -->
                            <form asp-action="Devolver" asp-route-id="@Model.TN_Id_Prestamo" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary" onclick="return confirm('¿Está seguro de registrar la devolución?')">
                                    <i class="bi bi-arrow-return-left"></i> Registrar Devolución
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
            else if (User.IsInRole("Estudiante") && Model.TN_Id_Estado == 1)
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Acciones</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Cancelar" asp-route-id="@Model.TN_Id_Prestamo" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Está seguro de cancelar esta reserva?')">
                                <i class="bi bi-x-circle"></i> Cancelar Mi Reserva
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .table th {
        background-color: #f8f9fa;
        font-weight: bold;
    }
</style>