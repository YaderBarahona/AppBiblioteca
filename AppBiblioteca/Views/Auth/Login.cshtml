
   @{
    Layout = null;
}






<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Iniciar Sesión</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- estilo login -->
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

    <style>

    </style>
</head>
<body>

    <div class="login-card">
        <div class="text-center mb-4">
            @*<i class="bi bi-person-circle" style="font-size: 3rem; color: #0d6efd;"></i>*@
            <div class="align-items-center"> 
                <img src="~/images/logo.jpg"
                     alt="Logo Biblioteca"
                     style="height:90px; width:auto;"
                     class="me-2" />          
            </div>
            <h2>Iniciar Sesión</h2>
        </div>

        <form asp-action="Login" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                    <input type="email" name="email" class="form-control" placeholder="Email" required />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                    <input name="password" type="password" class="form-control" required placeholder="Contraseña" />
                    
                </div>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-dark rounded-pill">Entrar</button>

                @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger mt-3">
                        @ViewData.ModelState[string.Empty].Errors[0].ErrorMessage
                    </div>
                }
            </div>
        </form>



        <div class="d-flex justify-content-center w-100 mt-3">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index"> <i class="bi bi-house-door-fill" ></i></a>
            <button class="navbar-toggler " type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" title="Pagina Principal">
            <span class="navbar-toggler-icon"></span>
        </button>
        </div>

    </div>

</body>
</html>



