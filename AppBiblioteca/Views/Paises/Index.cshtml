@model IEnumerable<AppBiblioteca.Models.Pais>
@{
    ViewData["Title"] = "Lista de Paises";
}

<div class="mb-5 pt-5">
    <h2 class=" text-center text-dark">@ViewData["Title"]</h2>
</div>

<a asp-action="Create" class="btn btn-success mb-3 rounded-pill">
    <i class="bi bi-plus-circle"></i> Agregar Nuevo País
</a>

<div class="mb-3 card-glow">
    <div class="table-responsive">

    <table class="table table-striped">
    <thead class="table-dark">
        <tr><th>Id</th><th>País</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id_Pais</td>
                <td>@p.NombrePais</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id_Pais"
                               class="btn btn-sm btn-outline-dark rounded-pill" title="Editar">
                        <i class="bi bi-pencil-fill"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
    </table>

    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', text: ok });
          }
        });
    </script>
}