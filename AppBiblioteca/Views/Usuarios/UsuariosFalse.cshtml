@model IEnumerable<AppBiblioteca.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios Bloqueados";
}

<div class="mb-5 pt-5">
    <h2 class=" text-center text-dark">@ViewData["Title"]</h2>
</div>

<!-- Botón para crear nuevo usuario -->
    <a asp-controller="Usuarios"
       asp-action="Create"
   class="btn btn-success rounded-pill mb-3">
        <i class="bi bi-person-plus"></i>  <!-- Ícono (Bootstrap Icons) -->
    Agregar Nuevo Usuario
    </a>



<div class="mb-3 card-glow">
    <div class="table-responsive">
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Usuario</th>
            <th>Apellido</th>
            <th>Cédula</th>
            <th>Email</th>
            <th>Sección</th>
            <th>Teléfono</th>
            <th>Rol</th>
            <th>Activo</th>
            @* Solo Administrador ve cabecera de Acciones *@
            @if (User.IsInRole("Administrador"))
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id_Usuario</td>
                <td>@u.UserName</td>
                <td>@u.LastName</td>
                <td>@u.Cedula</td>
                <td>@u.Email</td>
                <td>@(u.Seccion ?? "-")</td>
                <td>@(u.Telefono ?? "-")</td>
                <td>@u.Role</td>
                <td>
                    @if (User.IsInRole("Administrador"))
                    {
                        <form asp-action="ToggleFalse"
                              asp-route-id="@u.Id_Usuario"
                              method="post"
                              class="form-check form-switch m-0"
                              style="display:inline-block">
                            @Html.AntiForgeryToken()
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   onchange="this.form.submit()"
                            @(u.Activo ? "checked" : "") />
                        </form>
                    }
                    else
                    {
                        @if (u.Activo)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    }
                </td>



                @* Solo Administrador ve los íconos de Editar y Dar de baja *@
                @if (User.IsInRole("Administrador"))
                {
                    <td>
                        <!-- Editar -->
                        <a asp-action="Edit"
                           asp-route-id="@u.Id_Usuario"
                                   class="btn btn-sm btn-outline-dark rounded-pill me-2"
                           title="Editar">
                            <i class="bi bi-pencil-fill"></i>
                        </a>

                    </td>
                }



            </tr>
        }
    </tbody>
</table>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', text: ok });
          }
        });
    </script>
}