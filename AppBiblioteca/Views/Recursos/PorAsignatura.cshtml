@model List<AppBiblioteca.Models.RecursoExterno>

@{
    ViewData["Title"] = "Recursos de " + ViewBag.NombreAsignatura;
}

<div class="container-fluid mt-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-book text-primary"></i>
            Recursos de @ViewBag.NombreAsignatura
        </h2>
        <div>
            <a asp-action="Buscar" class="btn btn-outline-secondary">
                <i class="bi bi-search"></i> Búsqueda
            </a>
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-house"></i> Inicio
            </a>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Resultados -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="mb-4">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i>
                Se encontraron <strong>@Model.Count</strong> recurso(s) para esta asignatura
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var recurso in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm card-hover">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">
                                <i class="@recurso.TC_Icono"></i>
                                @recurso.TC_Titulo
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-person-badge"></i> <strong>Profesor:</strong> @recurso.NombreProfesor
                                </small>
                            </p>
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-tag"></i> <strong>Tipo:</strong> @recurso.TC_TipoContenido
                                </small>
                            </p>
                            @if (!string.IsNullOrEmpty(recurso.TC_Descripcion))
                            {
                                <p class="card-text">
                                    @if (recurso.TC_Descripcion.Length > 120)
                                    {
                                        @recurso.TC_Descripcion.Substring(0, 120)<text>...</text>
                                    }
                                    else
                                    {
                                        @recurso.TC_Descripcion
                                    }
                                </p>
                            }
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i> Publicado: @recurso.TF_FechaCreacion.ToString("dd/MM/yyyy")
                                </small>
                            </p>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="d-flex gap-2">
                                <a asp-action="Ver" asp-route-id="@recurso.TN_Id_Contenido"
                                   class="btn btn-sm btn-outline-primary flex-fill">
                                    <i class="bi bi-eye"></i> Ver Detalles
                                </a>
                                <a href="@recurso.TC_URL" target="_blank"
                                   class="btn btn-sm btn-success flex-fill">
                                    <i class="bi bi-box-arrow-up-right"></i> Acceder
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>No hay recursos disponibles</strong> para esta asignatura en este momento.
        </div>
        <div class="text-center mt-4">
            <a asp-action="Buscar" class="btn btn-primary">
                <i class="bi bi-search"></i> Buscar Otros Recursos
            </a>
        </div>
    }
</div>

<style>
    .card-hover {
        transition: all 0.3s ease;
    }

    .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .card {
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .card-footer {
        border-radius: 0 0 10px 10px !important;
    }
</style>