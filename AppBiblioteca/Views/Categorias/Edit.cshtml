@model AppBiblioteca.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoría";
}


<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id_Categoria" />

    <div class="mb-5 pt-5">
    <h2 class=" text-center text-dark">@ViewData["Title"]</h2>
    </div>

    <div class="mb-3 card-glow">
      <div class="mb-3">
        <label asp-for="CategoriaNombre" class="form-label">Categoría</label>
        <input asp-for="CategoriaNombre" class="form-control rounded-pill" />
        <span asp-validation-for="CategoriaNombre" class="text-danger"></span>
      </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <input asp-for="Descripcion" class="form-control rounded-pill" />
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>


        <div class="mt-3">
    <button type="submit" class="btn btn-dark rounded-pill">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary rounded-pill ms-2">Cancelar</a>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
          // error...
          var err = '@Html.Raw(TempData["ErrorMessage"])';
          if (err) {
            Swal.fire({ icon:'error', title:'Lo sentimos', text: err, confirmButtonColor: '#000000' });
          }

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', title:'Proceso Completado', text: ok, confirmButtonColor: '#000000' });
          }
        });
    </script>
}