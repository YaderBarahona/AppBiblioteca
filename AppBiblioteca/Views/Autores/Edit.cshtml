@*<form asp-action="Edit" asp-route-id="@Model.Id_Autor" method="post">*@
<form asp-action="Edit"  method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id_Autor" />

    <div class="mb-5 pt-5">
        <h2 class=" text-center text-dark">@ViewData["Title"]</h2>
    </div>

  <div class="mb-3 card-glow">

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control rounded-pill" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Apellidos" class="form-label">Apellidos</label>
            <input asp-for="Apellidos" class="form-control rounded-pill" />
        <span asp-validation-for="Apellidos" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Id_Pais" class="form-label">País</label>
            <select asp-for="Id_Pais" class="form-select rounded-pill">
            <option value="">-- Seleccione un país --</option>
            @foreach (var p in listaPaises)
            {
                <option value="@p.Id">@p.Nombre</option>
            }
        </select>
        <span asp-validation-for="Id_Pais" class="text-danger"></span>
    </div>

        <button type="submit" class="btn btn-dark rounded-pill">Actualizar Autor</button>
        <a asp-action="Index" class="btn btn-secondary rounded-pill ms-2">Cancelar</a>
  </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
          // error...
          var err = '@Html.Raw(TempData["ErrorMessage"])';
          if (err) {
            Swal.fire({ icon:'error', title:'¡Ups!', text: err });
          }

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', title:'¡Bien!', text: ok });
          }
        });
    </script>
}






