@model AppBiblioteca.Models.ContenidosExternosViewModel

@{
    ViewData["Title"] = "Gestión de Contenidos Externos";
}

<div class="container-fluid mt-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-cloud-arrow-up text-primary"></i>
            Contenidos Externos
        </h2>
        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuevo Contenido
            </a>
        }
    </div>

    <!-- Alertas -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-funnel"></i> Filtros de Búsqueda
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Asignatura</label>
                        <select name="filtroAsignatura" class="form-select" asp-items="Model.AsignaturasList"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo de Contenido</label>
                        <select name="filtroTipoContenido" class="form-select" asp-items="Model.TiposContenidoList"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">&nbsp;</label>
                        <div class="form-check">
                            <input type="checkbox" name="mostrarInactivos" value="true" class="form-check-input"
                                   id="mostrarInactivos" @(Model.MostrarInactivos ? "checked" : "")>
                            <label class="form-check-label" for="mostrarInactivos">
                                Mostrar contenidos inactivos
                            </label>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Limpiar Filtros
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultados -->
    @if (Model.HasResults)
    {
        <div class="mb-3">
            <p class="text-muted">
                <i class="bi bi-info-circle"></i>
                Se encontraron <strong>@Model.TotalResultados</strong> contenido(s)
            </p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var contenido in Model.Contenidos)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm @(contenido.TB_Activo ? "" : "border-danger")">
                        <div class="card-header bg-primary text-white">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-0">
                                    <i class="@contenido.TC_Icono"></i>
                                    @contenido.TC_Titulo
                                </h5>
                                @if (!contenido.TB_Activo)
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-person-badge"></i> <strong>Profesor:</strong> @contenido.NombreProfesor
                                </small>
                            </p>
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-book"></i> <strong>Asignatura:</strong>
                                    <span class="badge bg-info text-dark">@contenido.NombreAsignatura</span>
                                </small>
                            </p>
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-tag"></i> <strong>Tipo:</strong> @contenido.TC_TipoContenido
                                </small>
                            </p>
                            @if (!string.IsNullOrEmpty(contenido.TC_Descripcion))
                            {
                                <p class="card-text">
                                    @if (contenido.TC_Descripcion.Length > 100)
                                    {
                                        @contenido.TC_Descripcion.Substring(0, 100)<text>...</text>
                                    }
                                    else
                                    {
                                        @contenido.TC_Descripcion
                                    }
                                </p>
                            }
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i> Publicado: @contenido.TF_FechaCreacion.ToString("dd/MM/yyyy")
                                </small>
                            </p>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@contenido.TN_Id_Contenido"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                                <a href="@contenido.TC_URL" target="_blank" class="btn btn-sm btn-success">
                                    <i class="bi bi-box-arrow-up-right"></i> Ir al Recurso
                                </a>
                                @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                                {
                                    <a asp-action="Edit" asp-route-id="@contenido.TN_Id_Contenido"
                                       class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    @if (contenido.TB_Activo)
                                    {
                                        <form asp-action="Delete" asp-route-id="@contenido.TN_Id_Contenido"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('¿Está seguro de eliminar este contenido?')">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            <strong>No se encontraron contenidos externos.</strong>
            @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
            {
                <text>Puedes crear uno nuevo haciendo clic en el botón "Nuevo Contenido".</text>
            }
        </div>
    }
</div>

<style>
    .card {
        border-radius: 10px;
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1) !important;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .card-footer {
        border-radius: 0 0 10px 10px !important;
    }
</style>