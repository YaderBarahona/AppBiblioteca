@model IEnumerable<AppBiblioteca.Models.BajaMaterial>
@{
    ViewData["Title"] = "Historial de Bajas";
}

<div class="mb-5 pt-5">
    <h2 class="text-center text-dark">@ViewData["Title"]</h2>
    <p class="text-center text-muted">Registro de todos los ejemplares dados de baja del inventario</p>
</div>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary rounded-pill">
        <i class="bi bi-arrow-left"></i> Volver a Materiales
    </a>
</div>

<div class="mb-3 card-glow">
    <div class="table-responsive">
        @if (Model.Any())
        {
            <table class="table table-bordered table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Material</th>
                        <th>ISBN</th>
                        <th>Cantidad</th>
                        <th>Motivo</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FechaBaja.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.TituloMaterial</td>
                            <td>@item.ISBN</td>
                            <td class="text-center">
                                <span class="badge bg-danger">@item.Cantidad</span>
                            </td>
                            <td>@item.Observacion</td>
                            <td>@item.NombreUsuario</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info text-center m-4" role="alert">
                <i class="bi bi-info-circle fs-4"></i>
                <p class="mb-0 mt-2">No hay registros de bajas en el sistema.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Mostrar mensajes de éxito/error si existen
            var ok = '@Html.Raw(TempData["SuccessMessage"])';
            if (ok) {
                Swal.fire({ icon: 'success', text: ok });
            }

            var err = '@Html.Raw(TempData["ErrorMessage"])';
            if (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: err });
            }
        });
    </script>
}
