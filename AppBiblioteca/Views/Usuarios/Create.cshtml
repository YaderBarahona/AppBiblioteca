@model AppBiblioteca.Models.Usuario
@{
    ViewData["Title"] = "Agregar Nuevo Usuario";
    var roles = (List<(int Id, string Name)>)ViewBag.Roles;
}


<div class="mb-5 pt-5">
    <h2 class=" text-center text-dark">@ViewData["Title"]</h2>
</div>


<form asp-action="Create" method="post">
    <div class="mb-3 card-glow text-dark">
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control rounded-pill" placeholder="ejemplo@email.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Contraseña</label>
            <input asp-for="Password" type="password" class="form-control rounded-pill" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UserName" class="form-label">Nombre</label>
            <input asp-for="UserName" class="form-control rounded-pill" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label">Apellidos</label>
            <input asp-for="LastName" class="form-control rounded-pill" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Cedula" class="form-label">Cédula</label>
            <input asp-for="Cedula" class="form-control rounded-pill" placeholder="501230456" />
        <span asp-validation-for="Cedula" class="text-danger"></span>
    </div>

    <!-- select dinámico de roles -->
    <div class="mb-3">
        <label class="form-label">Rol</label>
            <select name="selectedRoleId" class="form-select rounded-pill" required>
                <option value="">Seleccione un rol</option>
            @foreach (var r in roles)
            {
                <option value="@r.Id">@r.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Seccion" class="form-label">Sección</label>
            <input asp-for="Seccion" class="form-control rounded-pill" placeholder="Solo para Estudiantes" />
        <span asp-validation-for="Seccion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefono" class="form-label">Teléfono</label>
            <input asp-for="Telefono" class="form-control rounded-pill" placeholder="8888-8888" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

        <button type="submit" class="btn btn-dark rounded-pill">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary rounded-pill ms-2">Cancelar</a>


    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
          // error...
          var err = '@Html.Raw(TempData["ErrorMessage"])';
          if (err) {
            Swal.fire({ icon:'error', title:'¡Ups!', text: err });
          }

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', title:'¡Bien!', text: ok });
          }
        });
    </script>
}
