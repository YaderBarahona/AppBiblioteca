@model AppBiblioteca.Models.BusquedaUsuariosViewModel
@{
    ViewData["Title"] = "Buscar Usuarios";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold">👥 Buscar Usuarios</h2>
                    <p class="text-muted">Consulta de usuarios registrados en el sistema</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    </div>

    <!-- Formulario de búsqueda -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros de Búsqueda</h5>
        </div>
        <div class="card-body">
            <form asp-action="BuscarUsuarios" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="UserName" class="form-label">Nombre de Usuario</label>
                        <input asp-for="UserName" class="form-control" placeholder="Buscar por nombre..." />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Buscar por email..." />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IdRol" class="form-label">Rol</label>
                        <select asp-for="IdRol" asp-items="Model.Roles" class="form-select"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Activo" class="form-label">Estado</label>
                        <select asp-for="Activo" asp-items="Model.EstadosActivo" class="form-select"></select>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <a asp-action="BuscarUsuarios" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultados -->
    @if (Model.HasSearched)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul"></i> Resultados de Búsqueda
                    @if (Model.HasResults)
                    {
                        <span class="badge bg-success">@Model.Resultados.Count</span>
                    }
                </h5>
            </div>
            <div class="card-body">
                @if (Model.HasResults)
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-success">
                                <tr>
                                    <th>Usuario</th>
                                    <th>Email</th>
                                    <th>Rol</th>
                                    <th>Estado</th>
                                    <th>Préstamos Activos</th>
                                    <th>Total Préstamos</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in Model.Resultados)
                                {
                                    <tr>
                                        <td>
                                            <strong>@usuario.TC_UserName</strong>
                                        </td>
                                        <td>@usuario.TC_Email</td>
                                        <td>
                                            @if (usuario.NombreRol == "Administrador")
                                            {
                                                <span class="badge bg-danger">@usuario.NombreRol</span>
                                            }
                                            else if (usuario.NombreRol == "Bibliotecario")
                                            {
                                                <span class="badge bg-warning text-dark">@usuario.NombreRol</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">@usuario.NombreRol</span>
                                            }
                                        </td>
                                        <td>
                                            @if (usuario.TB_Activo)
                                            {
                                                <span class="badge bg-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactivo</span>
                                            }
                                        </td>
                                        <td>
                                            @if (usuario.PrestamosActivos > 0)
                                            {
                                                <span class="badge bg-primary">@usuario.PrestamosActivos</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@usuario.TotalPrestamos</span>
                                        </td>
                                        <td>
                                            <a asp-controller="Usuarios" asp-action="Details" asp-route-id="@usuario.TN_Id_Usuario"
                                               class="btn btn-sm btn-outline-success rounded-pill">
                                                <i class="bi bi-eye"></i> Ver
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0" role="alert">
                        <i class="bi bi-info-circle"></i>
                        No se encontraron usuarios con los criterios especificados.
                    </div>
                }
            </div>
        </div>
    }
</div>