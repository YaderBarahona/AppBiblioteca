@model IEnumerable<AppBiblioteca.Models.Autor>

@{
    ViewData["Title"] = "Lista de Autores";
}

<div class="mb-5 pt-5">
    <h2 class=" text-center text-dark">@ViewData["Title"]</h2>
</div>

    <a asp-action="Create" class="btn btn-success mb-3  rounded-pill">
        <i class="bi bi-person-plus"></i> Agregar Nuevo Autor
    </a>

<div class="mb-3 card-glow">
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>País</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Id_Autor</td>
                    <td>@a.Nombre</td>
                    <td>@a.Apellidos</td>
                    <td>@a.NombrePais</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@a.Id_Autor"
                               class="btn btn-sm btn-outline-dark rounded-pill me-2"
                           title="Editar">
                                <i class="bi bi-pencil-fill"></i>
                        </a>
                        @* Delete o similar se agrega aquí *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', text: ok });
          }
        });
    </script>
}