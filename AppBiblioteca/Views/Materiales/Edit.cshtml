@model AppBiblioteca.Models.Material

@{
    ViewData["Title"] = "Editar Material";
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id_Material)

    <div class="mb-5 pt-5">
        <h2 class="text-center text-dark">@ViewData["Title"]</h2>
        <p class="text-center text-muted">Editando: <strong>@Model.Titulo</strong></p>
    </div>

    <div class="mb-3 card-glow">

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ISBN" class="form-label"></label>
            <input asp-for="ISBN" class="form-control" />
            <span asp-validation-for="ISBN" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AnioPublicacion" class="form-label"></label>
            <select asp-for="AnioPublicacion"
                    class="form-select"
                    asp-items="ViewBag.Years">
                <option value="">-- Seleccione año --</option>
            </select>
            <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Idioma" class="form-label"></label>
            <input asp-for="Idioma" class="form-control" />
            <span asp-validation-for="Idioma" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Cantidad" class="form-label"></label>
                <input asp-for="Cantidad" class="form-control" type="number" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
                <small class="form-text text-muted">Total de ejemplares</small>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Disponibles" class="form-label"></label>
                <input asp-for="Disponibles" class="form-control" type="number" />
                <span asp-validation-for="Disponibles" class="text-danger"></span>
                <small class="form-text text-muted">Ejemplares disponibles</small>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" class="form-select">
                <option value="">-- Seleccione estado --</option>
                <option value="Disponible">Disponible</option>
                <option value="No Disponible">No Disponible</option>
            </select>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Id_Categoria" class="form-label"></label>
            <select asp-for="Id_Categoria"
                    asp-items="Model.CategoryList"
                    class="form-select">
                <option value="">-- Seleccione categoría --</option>
            </select>
            <span asp-validation-for="Id_Categoria" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Id_Editorial" class="form-label"></label>
            <select asp-for="Id_Editorial"
                    asp-items="Model.EditorialList"
                    class="form-select">
                <option value="">-- Seleccione editorial --</option>
            </select>
            <span asp-validation-for="Id_Editorial" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Autores</label>
            <div class="checkbox-box">
                @foreach (var author in Model.AutorList)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="SelectedAutorIds"
                               value="@author.Value"
                               id="autor_@author.Value"
                               @(author.Selected ? "checked" : "") />
                        <label class="form-check-label"
                               for="autor_@author.Value">
                            @author.Text
                        </label>
                    </div>
                }
            </div>
            <span asp-validation-for="SelectedAutorIds" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-dark rounded-pill">
            <i class="bi bi-save"></i> Actualizar
        </button>
        <a asp-action="Index" class="btn btn-secondary rounded-pill ms-2">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
          // error...
          var err = '@Html.Raw(TempData["ErrorMessage"])';
          if (err) {
            Swal.fire({ icon:'error', title:'¡Ups!', text: err });
          }

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', title:'¡Bien!', text: ok });
          }
        });
    </script>
}