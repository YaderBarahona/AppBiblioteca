



@model AppBiblioteca.Models.Editorial

@{
    ViewData["Title"] = "Editar Editorial";
    var listaPaises = ViewBag.Paises 
                      as List<(int Id, string Nombre)> 
                      ?? new List<(int, string)>();
}



