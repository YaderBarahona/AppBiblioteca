@model AppBiblioteca.Models.Pais
@{
    ViewData["Title"] = "Agregar Nuevo País";
}


<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-5 pt-5">
        <h2 class=" text-center text-dark">@ViewData["Title"]</h2>
    </div>

  <div class="mb-3 card-glow">
    <div class="mb-3">
        <label asp-for="NombrePais" class="form-label">País</label>
        <input asp-for="NombrePais" class="form-control rounded-pill" placeholder="Nombre del País" />
        <span asp-validation-for="NombrePais" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-dark rounded-pill">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary rounded-pill ms-2">Cancelar</a>

  </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
          // error...
          var err = '@Html.Raw(TempData["ErrorMessage"])';
          if (err) {
            Swal.fire({ icon:'error', title:'¡Ups!', text: err });
          }

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', title:'¡Bien!', text: ok });
          }
        });
    </script>
}
