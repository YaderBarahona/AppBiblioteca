@model AppBiblioteca.Models.Material

@{
    ViewData["Title"] = "Agregar Ejemplares";
}

<div class="mb-5 pt-5">
    <h2 class="text-center text-dark">@ViewData["Title"]</h2>
    <p class="text-center text-muted">Material: <strong>@Model.Titulo</strong></p>
</div>

<div class="mb-3 card-glow">
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">Informaci�n Actual</h5>
                    <p class="card-text">
                        <strong>ISBN:</strong> @Model.ISBN<br />
                        <strong>Cantidad Total:</strong> @Model.Cantidad ejemplares<br />
                        <strong>Disponibles:</strong> @Model.Disponibles ejemplares
                    </p>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="AgregarEjemplares" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id_Material" />

        <div class="mb-3">
            <label for="cantidadAgregar" class="form-label">Cantidad de Ejemplares a Agregar</label>
            <input type="number"
                   class="form-control"
                   id="cantidadAgregar"
                   name="cantidadAgregar"
                   min="1"
                   required
                   placeholder="Ingrese la cantidad" />
            <small class="form-text text-muted">
                Ingrese la cantidad de nuevos ejemplares que desea agregar al inventario.
            </small>
        </div>

        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i>
            <strong>Nota:</strong> Al agregar ejemplares, se incrementar� tanto la cantidad total como los disponibles.
        </div>

        <button type="submit" class="btn btn-success rounded-pill">
            <i class="bi bi-plus-circle"></i> Agregar Ejemplares
        </button>
        <a asp-action="Index" class="btn btn-secondary rounded-pill ms-2">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
          // error...
          var err = '@Html.Raw(TempData["ErrorMessage"])';
          if (err) {
            Swal.fire({ icon:'error', title:'�Ups!', text: err });
          }

          // �xito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', title:'�Bien!', text: ok });
          }
        });
    </script>
}