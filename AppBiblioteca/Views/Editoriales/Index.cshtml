@model IEnumerable<AppBiblioteca.Models.Editorial>

@{
    ViewData["Title"] = "Listado de Editoriales";
}

<div class="mb-5 pt-5">
    <h2 class=" text-center text-dark">@ViewData["Title"]</h2>
</div>




<a asp-action="Create" class="btn btn-success rounded-pill mb-3">
    <i class="bi bi-person-plus"></i> Agregar Nuevo Editorial
    </a>

<div class="mb-3 card-glow">
    <div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>País</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Id_Editorial</td>
                    <td>@a.EditorialNombre</td>                  
                    <td>@a.NombrePais</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@a.Id_Editorial"
                               class="btn btn-sm btn-outline-dark rounded-pill me-2"
                           title="Editar">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        @* Si tienes Delete o similar, agrégalo aquí *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

          // éxito...
          var ok = '@Html.Raw(TempData["SuccessMessage"])';
          if (ok) {
            Swal.fire({ icon:'success', text: ok });
          }
        });
    </script>
}